{
  "manifest_version": 3,
  "name": "Focus Guard",
  "version": "2.3.2",
  "description": "Focus timer, sticky-note tasks, a growing focus garden and streaks, plus puzzles that stop YouTube Shorts doomscrolling.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Focus Guard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "lib/settings.js",
        "lib/captcha.js",
        "lib/puzzles.js",
        "lib/pomodoro.js",
        "lib/tasks.js",
        "lib/progress.js",
        "content/overlay-style.js",
        "content/puzzle-view.js",
        "content/shorts-guard.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "commands": {
    "toggle-timer": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Start or pause the focus timer"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/bitcount-prop-single.woff2",
        "fonts/shadows-into-light.woff2"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ]
    }
  ]
}
